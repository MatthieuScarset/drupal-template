{
  "name": "matthieuscarset/drupal-template",
  "description": "Project template for Drupal projects with Composer",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Matthieu Scarset",
      "email": "m@matthieuscarset.com",
      "homepage": "https://matthieuscarset.com"
    }
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  ],
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2",
    "cweagans/composer-patches": "^1",
    "drupal/config_ignore": "^3.3",
    "drupal/config_split": "^2.0",
    "drupal/core-composer-scaffold": "^11",
    "drupal/core-recommended": "^11",
    "drupal/shield": "^1.8",
    "drush/drush": "^13",
    "vlucas/phpdotenv": "^5",
    "webflo/drupal-finder": "^1"
  },
  "require-dev": {
    "drupal/coder": "^8.3",
    "drupal/core-dev": "^11.1"
  },
  "conflict": {
    "drupal/drupal": "*"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "discard-changes": true,
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupal/core-composer-scaffold": true,
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "tbachert/spi": true
    }
  },
  "autoload": {
    "classmap": [
      "scripts/composer/ScriptHandler.php"
    ],
    "files": [
      "load.environment.php"
    ]
  },
  "scripts": {
    "pre-install-cmd": [
      "cp -n .env.example .env",
      "echo $RANDOM | md5sum | head -c 20 > web/sites/default/salt.txt"
    ],
    "post-install-cmd": [
      "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
    ],
    "post-update-cmd": [
      "DrupalProject\\composer\\ScriptHandler::createRequiredFiles"
    ],
    "code-fix": [
      "DrupalProject\\composer\\ScriptHandler::codeFix"
    ],
    "code-check": [
      "DrupalProject\\composer\\ScriptHandler::codeCheck"
    ],
    "code-scan": [
      "DrupalProject\\composer\\ScriptHandler::codeScan"
    ],
    "code-clean": [
      "DrupalProject\\composer\\ScriptHandler::codeClean"
    ],
    "test": [
      "DrupalProject\\composer\\ScriptHandler::runRest"
    ]
  },
  "extra": {
    "drupal-scaffold": {
      "locations": {
        "web-root": "web/"
      }
    },
    "installer-paths": {
      "web/core": [
        "type:drupal-core"
      ],
      "web/libraries/{$name}": [
        "type:drupal-library"
      ],
      "web/modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "web/profiles/contrib/{$name}": [
        "type:drupal-profile"
      ],
      "web/themes/contrib/{$name}": [
        "type:drupal-theme"
      ],
      "drush/Commands/contrib/{$name}": [
        "type:drupal-drush"
      ]
    },
    "composer-exit-on-patch-failure": true,
    "patchLevel": {
      "drupal/core": "-p2"
    },
    "patches": {}
  }
}
